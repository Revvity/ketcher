{
  "name": "@acd/ketcher",
  "version": "3.4.3",
  "private": false,
  "license": "MIT",
  "description": "ACD/Labs Ketcher web component",
  "repository": {
    "type": "git",
    "url": "git@github.com:Revvity/ketcher.git"
  },
  "engines": {
    "yarn": "9999.99.99",
    "node": "18.19.1"
  },
  "main": "acd-ketcher-web-component.js",
  "types": "kc-types.d.ts",
  "detils": {
    "buildCommand": "npx webpack",
    "packDirectory": "dist"
  },
  "scripts": {
    "build": "webpack --env NODE_ENV=production",
    "build:watch": "webpack --watch",
    "test": "karma start --browsers ChromeDocker --singleRun true",
    "test:watch": "karma start --browsers ChromeDocker --singleRun false",
    "test:ci": "npm run test"
  },
  "devDependencies": {
    "ketcher-core": "../packages/ketcher-core",
    "ketcher-react": "../packages/ketcher-react",
    "ketcher-standalone": "../packages/ketcher-standalone",
    "ketcher-macromolecules": "../packages/ketcher-macromolecules",
    "miew": "^0.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1",
    "@types/jasmine": "4.0.3",
    "@types/node": "^12.12.38",
    "@types/react": "^16.9.27",
    "@types/react-dom": "^16.9.7",
    "@types/resemblejs": "^4.1.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "jasmine-core": "4.2.0",
    "karma": "6.4.1",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.0.0",
    "karma-junit-reporter": "2.0.1",
    "karma-webpack": "^5.0.0",
    "mini-css-extract-plugin": "^2.7.2",
    "postcss": "^8.4.31",
    "resemblejs": "5.0.0",
    "sass": "^1.43.4",
    "sass-loader": "^13.2.0",
    "terser-webpack-plugin": "^5.3.6",
    "ts-loader": "^9.4.2",
    "typescript": "^4.3.5",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.11.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "ie 11",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
