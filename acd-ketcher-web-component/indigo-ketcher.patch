diff --git a/build-indigo-ketcher.cmd b/build-indigo-ketcher.cmd
new file mode 100644
index 000000000..69a244bbf
--- /dev/null
+++ b/build-indigo-ketcher.cmd
@@ -0,0 +1,88 @@
+@echo off
+setlocal
+
+:: ============================================================
+:: Settings — change only here
+:: ============================================================
+set MY_EMSDK_VERSION=3.1.74
+set MY_EMSDK_DIR=E:\work\emsdk
+set MY_INDIGO_DIR=E:\angular\Indigo
+set MY_BUILD_DIR=%MY_INDIGO_DIR%\build
+set MY_BIN_DIR=%MY_BUILD_DIR%\bin
+set MY_WASM_SRC_DIR=%MY_INDIGO_DIR%\api\wasm\indigo-ketcher
+
+:: ============================================================
+:: Step 1: Activate Emscripten
+:: ============================================================
+echo === Step 1: Activating Emscripten %MY_EMSDK_VERSION% ===
+call %MY_EMSDK_DIR%\emsdk activate %MY_EMSDK_VERSION%
+if %errorlevel% neq 0 ( echo ERROR: emsdk activate failed & exit /b 1 )
+
+call %MY_EMSDK_DIR%\emsdk_env.bat
+
+:: ============================================================
+:: Step 2: Prepare build directory
+:: ============================================================
+echo === Step 2: Preparing build directory ===
+cd /d %MY_INDIGO_DIR%
+if exist build rmdir /s /q build
+mkdir build
+
+:: ============================================================
+:: Step 3: CMake configuration
+:: ============================================================
+echo === Step 3: Running cmake ===
+cmd /c "emcmake cmake %MY_INDIGO_DIR% -DCMAKE_BUILD_TYPE=Release -G Ninja -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_C_FLAGS=-Wno-incompatible-pointer-types -DCMAKE_EXE_LINKER_FLAGS=-sENVIRONMENT=web,worker -DCMAKE_SHARED_LINKER_FLAGS=-sENVIRONMENT=web,worker -B %MY_BUILD_DIR%"
+if %errorlevel% neq 0 ( echo ERROR: cmake failed & exit /b 1 )
+echo OK: cmake done
+
+:: ============================================================
+:: Step 4: Build ninja targets
+:: ============================================================
+echo === Step 4: Building with ninja ===
+
+echo Building indigo-ketcher...
+cmd /c "ninja -C %MY_BUILD_DIR% indigo-ketcher"
+if %errorlevel% neq 0 ( echo ERROR: indigo-ketcher failed & exit /b 1 )
+echo OK: indigo-ketcher
+
+echo Building indigo-ketcher-separate...
+cmd /c "ninja -C %MY_BUILD_DIR% indigo-ketcher-separate"
+if %errorlevel% neq 0 ( echo ERROR: indigo-ketcher-separate failed & exit /b 1 )
+echo OK: indigo-ketcher-separate
+
+echo Building indigo-ketcher-norender...
+cmd /c "ninja -C %MY_BUILD_DIR% indigo-ketcher-norender"
+if %errorlevel% neq 0 ( echo ERROR: indigo-ketcher-norender failed & exit /b 1 )
+echo OK: indigo-ketcher-norender
+
+echo Building indigo-ketcher-separate-norender...
+cmd /c "ninja -C %MY_BUILD_DIR% indigo-ketcher-separate-norender"
+if %errorlevel% neq 0 ( echo ERROR: indigo-ketcher-separate-norender failed & exit /b 1 )
+echo OK: indigo-ketcher-separate-norender
+
+:: ============================================================
+:: Step 5: Copy package.json, LICENSE, README.md
+:: ============================================================
+echo === Step 5: Copying package files ===
+
+copy /y %MY_WASM_SRC_DIR%\package.json %MY_BIN_DIR%\
+if %errorlevel% neq 0 ( echo ERROR: copy package.json failed & exit /b 1 )
+echo OK: package.json
+
+copy /y %MY_WASM_SRC_DIR%\README.md %MY_BIN_DIR%\
+if %errorlevel% neq 0 ( echo ERROR: copy README.md failed & exit /b 1 )
+echo OK: README.md
+
+copy /y %MY_INDIGO_DIR%\LICENSE %MY_BIN_DIR%\
+if %errorlevel% neq 0 ( echo ERROR: copy LICENSE failed & exit /b 1 )
+echo OK: LICENSE
+
+:: ============================================================
+:: Summary
+:: ============================================================
+echo.
+echo ================================
+echo SUCCESS: All targets built!
+echo ================================
+dir %MY_BIN_DIR%
\ No newline at end of file
